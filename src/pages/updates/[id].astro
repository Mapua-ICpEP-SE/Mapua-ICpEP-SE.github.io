---
export const prerender = false;

import matter from "gray-matter";
import { marked } from "marked";
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const { id } = Astro.params;

if (!id) {
    return Astro.redirect("/404");
}

// Access the R2 bucket binding from cloudflare:workers
const bucket = env.CONTENT_BUCKET;

if (!bucket) {
    console.error("CONTENT_BUCKET binding is missing in Cloudflare environment settings.");
    return Astro.redirect("/404");
}

const object = await bucket.get(`${id}.md`);

if (!object) {
    return Astro.redirect("/404");
}

const rawText = await object.text();
const { data, content } = matter(rawText);
const htmlContent = await marked.parse(content);

const post = {
    title: data.title || "Untitled Update",
    tags: Array.isArray(data.tags) ? data.tags : data.tags ? [data.tags] : [],
    author: Array.isArray(data.author) ? data.author : data.author ? [data.author] : ["ICpEP.SE Mapúa"],
    date: data.date ? new Date(data.date) : null,
    video: data.video || null,
    image: data.image || null,
};
---

<Layout title={`${post.title} | ICpEP Mapua Updates`}>
    <Navbar />

    <main class="flex-grow pt-32 pb-24 px-6">
        <article class="max-w-4xl mx-auto">
            <!-- Back Button -->
            <a
                href="/updates"
                class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-icpep-blue transition-colors mb-8 group"
            >
                <svg
                    class="w-4 h-4 transition-transform group-hover:-translate-x-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"
                    ></path>
                </svg>
                Back to Updates
            </a>

            <!-- Post Header -->
            <header class="mb-12">
                <div class="flex flex-wrap gap-2 mb-6">
                    {post.tags.map((tag: string) => (
                        <span class="bg-[#2d3748] text-icpep-blue text-xs px-3 py-1 font-semibold tracking-wider uppercase">
                            {tag}
                        </span>
                    ))}
                </div>

                <h2 class="font-krona text-3xl md:text-5xl text-white leading-tight mb-6">
                    {post.title}
                </h2>

                <div class="flex items-center gap-4 text-sm text-gray-400 font-mono border-l-2 border-icpep-blue pl-4">
                    <span>By {post.author.join(", ")}</span>
                    <span>•</span>
                    <span>
                        {post.date
                            ? post.date.toLocaleDateString("en-US", {
                                  year: "numeric",
                                  month: "long",
                                  day: "numeric",
                              })
                            : "Date TBA"}
                    </span>
                </div>
            </header>

            <!-- Hero Media (Prioritizes Video, falls back to Image) -->
            {post.video ? (
                <div class="w-full h-[400px] md:h-[500px] rounded-xl overflow-hidden mb-16 border border-[#2d3748] bg-black">
                    <video
                        autoplay
                        loop
                        muted
                        playsinline
                        class="w-full h-full object-contain"
                    >
                        <source src={post.video} type="video/mp4" />
                        Your browser does not support the video tag.
                    </video>
                </div>
            ) : post.image ? (
                <div class="w-full h-[400px] md:h-[500px] rounded-xl overflow-hidden mb-16 border border-[#2d3748]">
                    <img
                        src={post.image}
                        alt={post.title}
                        class="w-full h-full object-cover"
                    />
                </div>
            ) : null}

            <!-- Render HTML converted from R2 Markdown -->
            <div class="prose-content" set:html={htmlContent} />
        </article>
    </main>

    <Footer />
</Layout>

<style is:global>
    @reference "../../styles/global.css";

    .prose-content {
        @apply text-gray-300 text-base md:text-lg leading-relaxed font-suse;
    }

    .prose-content h2,
    .prose-content h3,
    .prose-content h4 {
        @apply font-krona text-white mt-12 mb-6;
    }

    .prose-content h2 {
        @apply text-2xl md:text-3xl;
    }
    .prose-content h3 {
        @apply text-xl md:text-2xl;
    }

    .prose-content p {
        @apply mb-6;
    }

    .prose-content ul {
        @apply list-disc pl-6 mb-6 space-y-2 marker:text-icpep-blue;
    }
    .prose-content ol {
        @apply list-decimal pl-6 mb-6 space-y-2 marker:text-icpep-blue font-mono;
    }

    .prose-content a {
        @apply text-icpep-blue hover:underline hover:text-blue-400 transition-colors;
    }

    .prose-content strong {
        @apply text-white font-bold;
    }

    .prose-content blockquote {
        @apply border-l-4 border-icpep-blue bg-icpep-card p-6 mb-6 italic text-gray-400 rounded-r-lg;
    }

    .prose-content code {
        @apply bg-icpep-card text-icpep-blue px-2 py-1 rounded text-sm font-mono border border-[#2d3748];
    }
</style>
